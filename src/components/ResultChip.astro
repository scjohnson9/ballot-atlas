---
// ResultChip — the pass/fail marker rendered wherever a measure's
// election result surfaces. Two size variants:
//
//   size="small" — inline chip in IssueList, sits next to the ref
//                  ("Amendment 3 · ✓ Passed"). Compact, same visual
//                  weight for both outcomes.
//   size="large" — standalone block on the measure detail page,
//                  bigger type and more breathing room.
//
// Visual language: both outcomes use identical chip treatment (gold
// border, cream text, matching glyphs in gold). Neither chip implies
// "better" or "worse" — the outcome is a fact, CCTE's stance is
// presented separately, and alignment is left to the reader to
// interpret. This preserves the atlas's editorial neutrality while
// still giving results a clean visual home.
//
// When `official` is false (unofficial / election-night), an
// "Unofficial" tag renders next to the chip. Set to true once state
// canvass certifies; the tag disappears.

interface Props {
  outcome: 'passed' | 'failed';
  yesPercent: number;
  asOf: Date;
  official: boolean;
  size?: 'small' | 'large';
}

const { outcome, yesPercent, asOf, official, size = 'small' } = Astro.props;

const label = outcome === 'passed' ? 'Passed' : 'Failed';
const glyph = outcome === 'passed' ? '✓' : '✗';

function formatDate(d: Date): string {
  return d.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}

const pctDisplay = yesPercent.toFixed(1).replace(/\.0$/, '');
---

<span
  class={`result-chip result-chip--${size}`}
  title={!official ? `Unofficial — as of ${formatDate(asOf)}` : undefined}
>
  <span class="result-chip__glyph" aria-hidden="true">{glyph}</span>
  <span class="result-chip__label">{label}</span>
  {size === 'large' && (
    <>
      <span class="result-chip__sep" aria-hidden="true">·</span>
      <span class="result-chip__pct">{pctDisplay}% yes</span>
    </>
  )}
</span>

<style>
  .result-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: transparent;
    color: var(--quiet);
    font-family: 'EB Garamond', Georgia, serif;
    white-space: nowrap;
    vertical-align: baseline;
  }

  .result-chip--small {
    padding: 0.08em 0.6em 0.14em;
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .result-chip--large {
    padding: 0.28em 0.95em 0.38em;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .result-chip__glyph {
    color: var(--gold);
    font-weight: 600;
    font-size: 1em;
    line-height: 1;
    letter-spacing: 0;
  }

  .result-chip__label {
    color: var(--quiet);
    font-weight: 600;
  }

  .result-chip__sep {
    color: var(--quieter);
    padding: 0 0.1em;
    letter-spacing: 0;
  }

  .result-chip__pct {
    color: var(--body);
    font-variant-numeric: tabular-nums;
    text-transform: none;
    letter-spacing: 0.02em;
    font-weight: 500;
  }
</style>
